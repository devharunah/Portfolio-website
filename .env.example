# Copy to .env.local and fill in. Never commit .env.local.

# From sanity.io/manage → your project. Public by design (read-only dataset).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Canonical site URL for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://kakooza-harunah.vercel.app

# Server-only. Editor token, used only by `npm run seed`. Don't add it to Vercel.
SANITY_API_WRITE_TOKEN=

# Server-only. Any long random string; use the same value in the Sanity webhook.
SANITY_REVALIDATE_SECRET=
